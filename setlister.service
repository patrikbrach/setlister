[Unit]
Description=Setlist Lookup Web App
After=network.target

[Service]
WorkingDirectory=/home/patrikbrach/setlister
EnvironmentFile=/home/patrikbrach/setlister/.env
ExecStart=/home/patrikbrach/setlister/venv/bin/python main.py
Restart=on-failure
User=patrikbrach

[Install]
WantedBy=multi-user.target
